# Mod Editor / game-generated artifacts (if the game writes into the mod folder)
*.log
ModContent.hpk
Previews/

# tools/ is importable, so anything that imports doccheck leaves bytecode here
__pycache__/
*.pyc

# OS
Thumbs.db
Desktop.ini

# .claude/ is local scratch and never committed -- EXCEPT the skills and the
# subagent definitions, which are repo knowledge every session loads and
# therefore belong in the tree (from SMR-BugFixPack 2026-09-17, donor @ e6ec192).
# .agents/skills/ is the GENERATED byte mirror of .claude/skills/ for Codex --
# doccheck reds on drift; regenerate, never hand-edit.
.claude/*
!.claude/skills/
!.claude/agents/
